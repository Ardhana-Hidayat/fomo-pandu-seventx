# PANDU Environment Variables Example
# Salin berkas ini ke .env.local untuk pengembangan lokal

# Mode Penyimpanan Data: 'local' (PGlite) atau 'postgres' (Supabase/Postgres)
DATA_DRIVER=local
DATABASE_URL=

# Mode Penyimpanan Berkas: 'local' (.data/uploads) atau 'supabase'
STORAGE_DRIVER=local

# Mode Autentikasi: 'demo' (login 1-klik tanpa sandi) atau 'google'
AUTH_MODE=demo

# Rahasia Sesi (minimal 32 karakter untuk HMAC/kunci sesi)
SESSION_SECRET=dev-session-secret-at-least-32-characters-long-example

# Google Gemini API untuk pembuatan materi otomatis (opsional di dev jika memakai fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Penyedia Text-to-Speech: 'gemini' atau 'none'
TTS_PROVIDER=none

# Batas pembuatan materi AI per guru per jam
GENERATE_LIMIT_PER_HOUR=5

# Izinkan aset isyarat status draft ditampilkan
ALLOW_DRAFT_SIGNS=false

# URL Publik Aplikasi
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Konfigurasi Supabase (opsional, hanya saat DATA_DRIVER=postgres atau STORAGE_DRIVER=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

