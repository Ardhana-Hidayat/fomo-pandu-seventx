{
  "name": "pandu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "deps": "depcruise src --config dependency-cruiser.cjs",
    "unused": "knip",
    "audit": "npm audit --omit=dev --audit-level=high",
    "check": "npm run lint && npm run typecheck && npm run deps && npm run unused && npm run test",
    "check:env": "tsx scripts/check-env.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/db-migrate.ts",
    "db:seed": "tsx --conditions=react-server scripts/db-seed.ts",
    "db:reset": "tsx --conditions=react-server scripts/db-reset.ts",
    "signs:fetch": "tsx scripts/signs/fetch-sources.ts",
    "signs:analyze": "tsx scripts/signs/analyze.ts",
    "signs:build": "tsx scripts/signs/build-library.ts",
    "signs:review": "tsx scripts/signs/contact-sheet.ts",
    "media:pictos": "tsx scripts/media/fetch-pictograms.ts",
    "storage:upload": "tsx scripts/storage/upload-assets-supabase.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.14",
    "@google/genai": "^3.6.1",
    "@phosphor-icons/react": "^2.1.7",
    "@supabase/supabase-js": "^2.119.2",
    "drizzle-orm": "^0.39.3",
    "next": "16.4.6",
    "postgres": "^3.4.5",
    "qrcode.react": "^4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.33.5",
    "unpdf": "^0.12.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22",
    "@types/qrcode.react": "^1.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dependency-cruiser": "^16.9.0",
    "drizzle-kit": "^0.30.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^29.1.1",
    "knip": "^5.43.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.2.19",
    "@rolldown/binding-win32-x64-msvc": "1.2.19",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "@tailwindcss/oxide-win32-x64-msvc": "4.3.3",
    "lightningcss-linux-x64-gnu": "1.32.0",
    "lightningcss-win32-x64-msvc": "1.32.0"
  }
}
